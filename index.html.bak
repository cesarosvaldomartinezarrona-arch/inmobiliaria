<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inmobiliaria Premium - Dimorakot Style</title>
  <link rel="stylesheet" href="src/styles/variables.css">
  <link rel="stylesheet" href="src/styles/base.css">
  <link rel="stylesheet" href="src/components/ui/button.css">
  <link rel="stylesheet" href="src/components/ui/card.css">
  <link rel="stylesheet" href="src/components/ui/input.css">
  <link rel="stylesheet" href="src/components/ui/nav.css">
  <link rel="stylesheet" href="src/components/ui/avatar.css">
  <link rel="stylesheet" href="src/components/dashboard/dashboard.css">
  <link rel="stylesheet" href="src/components/banner/banner-manager.css">
  <link rel="stylesheet" href="src/components/public/public-page.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Fonts dimorakot: Outfit + DM Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100;300;400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet">
  
</head>
<body>

  <!-- Navigation Superior - estilo dimorakot -->
  <nav id="mainNav" class="nav">
    <div class="container">
      <div class="h-16 flex items-center justify-between">
        
        <!-- Logo -->
        <a href="https://dimorakot.com" class="flex items-center gap-2">
          <img src="../logo.jpeg" alt="Inmobiliaria Premium" class="h-8 w-auto">
          <span class="font-display font-extrabold text-xl tracking-tight text-primary hidden">DIMORA<span class="text-slate-300 font-bold">KOT</span></span>
        </a>

        <!-- Links navigation -->
        <div class="hidden md:flex items-center gap-1 bg-slate-50 rounded-full px-1 py-1">
          <a href="#" class="px-3 py-2 rounded-full text-sm font-medium transition-all bg-white text-slate-900 shadow-sm">Todo</a>
          <a href="#" class="px-3 py-2 rounded-full text-sm font-medium transition-all text-slate-500 hover:text-slate-700">Rentas</a>
          <a href="#" class="px-3 py-2 rounded-full text-sm font-medium transition-all text-slate-500 hover:text-slate-700">Ventas</a>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-2">
          <a href="#" class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold text-primary hover:bg-slate-50 rounded-full transition-colors">
            Publica tu propiedad
          </a>
          <a href="#" class="inline-flex items-center gap-2 pl-3 py-2 border border-primary rounded-full text-sm font-medium text-primary hover:bg-primary-100 transition-all" id="admin-nav-link">
            <span class="material-symbols-outlined">admin_panel_settings</span>
            <span>Panel Admin</span>
          </a>
          <a href="#" class="inline-flex items-center gap-2 pl-3 py-2 border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:shadow-md hover:border-slate-300 transition-all">
            <span class="material-symbols-outlined text-lg">menu</span>
            <span class="material-symbols-outlined filled text-lg text-slate-400">account_circle</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Contenedor principal -->
  <div class="natural-transition">
    
    <!-- Página Pública -->
    <div class="public-page" id="public-page">
      
      <!-- Hero / Header principal -->
      <header class="header-public" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1600&q=80');">
        <div class="header-public__container">
          <span class="badge-venta">En Renta</span>
          <h1 class="header-public__heading">
            <span class="font-display">Encuentra tu</span>
            <span class="text-primary font-display">hogar ideal</span>
          </h1>
          <p class="header-public__subtitle">Más de 500 propiedades disponibles en las mejores locaciones. Tu próximo hogar te espera.</p>
          
          <div class="header-public__stats">
            <div class="header-public__stat"><span class="header-public__stat-value font-display">128</span> Propiedades</div>
            <div class="header-public__stat"><span class="header-public__stat-value font-display">89</span> Disponibles</div>
          </div>
          
          <a href="#propiedades" class="btn btn-accent">Ver Propiedades</a>
        </div>
      </header>

      <!-- Buscador -->
      <section class="search-public">
        <form class="search-public__form" action="#">
          <input class="search-public__input" type="text" placeholder="Ciudad, barrio o palabra clave" aria-label="Buscar propiedades">
          <button class="search-public__btn" type="submit">Buscar</button>
        </form>
      </section>

      <!-- Carrusel de propiedades -->
      <section class="properties-carousel">
        <div class="carousel__track" id="carousel-track">
          <!-- Contenido insertado por JS -->
        </div>
      </section>

      <!-- Sección de propiedades -->
      <section class="properties-section" id="propiedades">
        <h2 class="properties-section__title">Propiedades Destacadas</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6" id="properties-grid">
          <!-- Tarjetas insertadas por JS -->
        </div>
      </section>

      <!-- Sidebar fijo con precio y formulario -->
      <aside class="sidebar-sticky">
        <div class="price-info">
          <span class="price-info__label">Renta mensual</span>
          <span class="price-info__value font-display">$38,500</span>
          <span class="/mes">/mes</span>
        </div>
        
        <div class="contact-form">
          <input class="contact-form__input" type="text" placeholder="Tu nombre" aria-label="Nombre">
          <input class="contact-form__input" type="tel" placeholder="Teléfono" aria-label="Teléfono">
          <button class="contact-form__btn btn-primary">Enviar mensaje</button>
        </div>
      </aside>

      <!-- Footer -->
      <footer class="page-footer">
        <div class="page-footer__container">
          <div class="page-footer__links">
            <a href="#" class="page-footer__link">Inicio</a>
            <a href="#" class="page-footer__link">Nosotros</a>
            <a href="#" class="page-footer__link">Contacto</a>
            <a href="#" class="page-footer__link">Blog</a>
          </div>
          <p class="page-footer__copy">© 2026 Inmobiliaria Premium. Todos los derechos reservados.</p>
        </div>
      </footer>

    </div>

    <!-- Dashboard Administrador -->
    <div class="dashboard-main" id="dashboard">
      <!-- Header navegación -->
      <nav class="nav--scrolled">
        <div class="container">
          <div class="h-16 flex items-center justify-between">
            <a href="#" class="flex items-center gap-2">
              <span class="font-display font-extrabold text-xl tracking-tight text-primary">DIMORA<span class="text-slate-300 font-bold">KOT</span></span>
            </a>
            <div class="hidden md:flex items-center gap-1 bg-slate-50 rounded-full px-1 py-1">
              <a href="#" class="px-3 py-2 rounded-full text-sm font-medium transition-all bg-white text-slate-900 shadow-sm">Todo</a>
              <a href="#" class="px-3 py-2 rounded-full text-sm font-medium transition-all text-slate-500 hover:text-slate-700">Rentas</a>
              <a href="#" class="px-3 py-2 rounded-full text-sm font-medium transition-all text-slate-500 hover:text-slate-700">Ventas</a>
            </div>
            <div class="flex items-center gap-2">
              <a href="#" class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold text-primary hover:bg-slate-50 rounded-full transition-colors">Panel</a>
              <a href="#" class="inline-flex items-center gap-2 pl-3 py-2 border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:shadow-md hover:border-slate-300 transition-all">
                <span class="material-symbols-outlined text-lg">menu</span>
                <span class="material-symbols-outlined filled text-lg text-slate-400">account_circle</span>
              </a>
            </div>
          </div>
        </div>
      </nav>

      <!-- Dashboard Header -->
      <header class="dashboard-header">
        <div class="dashboard-header__title">Panel de Control</div>
        <div class="dashboard-header__stats">
          <div class="dashboard-header__stat"><span class="dashboard-header__stat-value font-display">1,284</span> Propiedades</div>
          <div class="dashboard-header__stat"><span class="dashboard-header__stat-value font-display">89</span> Disponibles</div>
        </div>
      </header>

      <!-- Banner Destacado para Header -->
      <section class="banner-stats">
        <div class="banner-stat">
          <div class="banner-stat__number font-display">$38,500</div>
          <div class="banner-stat__label">Oferta Destacada</div>
        </div>
        <div class="banner-stat">
          <div class="banner-stat__number">Activo</div>
          <div class="banner-stat__label">Estado</div>
        </div>
      </section>

      <section class="quick-nav">
        <div class="quick-nav__title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Gestión de Banners
        </div>
        <div class="quick-nav__list">
          <article class="quick-nav__item">
            <div class="quick-nav__item-link">
              <span class="material-symbols-outlined">image</span>
              <span>Todos los Banners</span>
            </div>
          </article>
          <article class="quick-nav__item">
            <div class="quick-nav__item-link">
              <span class="material-symbols-outlined">star</span>
              <span>Banners Destacados</span>
            </div>
          </article>
          <article class="quick-nav__item">
            <div class="quick-nav__item-link">
              <span class="material-symbols-outlined">schedule</span>
              <span>Fechas Programadas</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Filtros Avanzados -->
      <section class="filters-advanced">
        <div class="filters-advanced__section">
          <span class="filters-advanced__section-title">Filtrar por</span>
          <div class="filter-group">
            <span class="filter-group__label">Estado</span>
            <select class="filter-group__select" id="statusFilter">
              <option value="all">Todos</option>
              <option value="available">Disponible</option>
              <option value="rent">En Renta</option>
              <option value="sold">Vendida</option>
            </select>
          </div>
          <div class="filter-group">
            <span class="filter-group__label">Tipo</span>
            <select class="filter-group__select" id="propertyType">
              <option value="all">Todos</option>
              <option value="house">Casa</option>
              <option value="apartment">Departamento</option>
              <option value="land">Terreno</option>
            </select>
          </div>
        </div>
        <div class="filters-advanced__section">
          <span class="filters-advanced__section-title">Rango de Precio</span>
          <div class="filter-group">
            <span class="filter-group__label">Desde</span>
            <input type="number" class="filter-group__select" placeholder="0" id="priceMin">
            <span class="filter-group__label">hasta</span>
            <input type="number" class="filter-group__select" placeholder="10000000" id="priceMax">
          </div>
        </div>
      </section>

      <!-- Estadísticas Detalladas -->
      <section class="detailed-stats">
        <div class="stat-card">
          <div class="stat-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9 6l9-6l-9-6l-9 6z"/>
              <path d="M3 12h25"/>
              <path d="M3 15h9"/>
              <path d="M3 18h17"/>
            </svg>
          </div>
          <div class="stat-card__number" id="stat-total">1,284</div>
          <div class="stat-card__label">Total Propiedades</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><path d="M18 20v-7"/>
            </svg>
          </div>
          <div class="stat-card__number" id="stat-available">89</div>
          <div class="stat-card__label">Disponibles</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3l2 14 2-14 3 9h13a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5l2-10z"/>
            </svg>
          </div>
          <div class="stat-card__number" id="stat-sold">231</div>
          <div class="stat-card__label">Vendidas</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l7 7v3"/>
            </svg>
          </div>
          <div class="stat-card__number" id="stat-rent">87</div>
          <div class="stat-card__label">En Renta</div>
        </div>
      </section>

      <!-- Tabla Avanzada de Propiedades -->
      <section class="advanced-table">
        <table>
          <thead>
            <tr>
              <th data-label="Propiedad">Propiedad</th>
              <th data-label="Precio">Precio</th>
              <th data-label="Estado">Estado</th>
              <th data-label="Ubicación">Ubicación</th>
              <th data-label="Acciones">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Casa en Miami Beach</td>
              <td class="price">$2,500,000</td>
              <td><span class="status-dot status-dot--available"></span>Disponible</td>
              <td>Miami Beach, FL</td>
              <td>
                <button class="btn btn-small btn-primary">Ver</button>
                <button class="btn btn-small btn-secondary">Editar</button>
              </td>
            </tr>
            <tr>
              <td>Departamento en Madrid</td>
              <td class="price">$450,000</td>
              <td><span class="status-dot status-dot--sold"></span>Vendida</td>
              <td>Madrid, España</td>
              <td>
                <button class="btn btn-small btn-secondary">Ver</button>
                <button class="btn btn-small btn-alert">Historial</button>
              </td>
            </tr>
            <tr>
              <td>Terreno en Santo Domingo</td>
              <td class="price">$350,000</td>
              <td><span class="status-dot status-dot--available"></span>Disponible</td>
              <td>Santo Domingo, RD</td>
              <td>
                <button class="btn btn-small btn-primary">Ver</button>
                <button class="btn btn-small btn-secondary">Detalles</button>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Gráficas de Resumen -->
      <section class="charts-summary">
        <div class="charts-summary__title">
          <span>Gráficas Resumen</span>
        </div>
        <div class="charts-row">
          <div class="chart-card">
            <div class="chart-card__label">Propiedades por Tipo</div>
            <canvas class="chart-card__canvas" id="chartPropertyType"></canvas>
          </div>
          <div class="chart-card">
            <div class="chart-card__label">Estados del Mercado</div>
            <canvas class="chart-card__canvas" id="chartMarketStatus"></canvas>
          </div>
        </div>
        <div class="charts-row">
          <div class="chart-card">
            <div class="chart-card__label">Ingresos Mensuales</div>
            <canvas class="chart-card__canvas" id="chartMonthlyIncome"></canvas>
          </div>
          <div class="chart-card">
            <div class="chart-card__label">Propiedades por Ubicación</div>
            <canvas class="chart-card__canvas" id="chartLocation"></canvas>
          </div>
        </div>
      </section>

      <!-- Acciones Masivas -->
      <section class="bulk-actions">
        <div class="bulk-actions__title">
          <span>Acciones Masivas</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="bulk-actions__toggle-icon">
            <path d="M9 18l6-6-6-6m7.5-4.5l-3 3-3-3"/>
          </svg>
          <span>Seleccionar todas</span>
          <input type="checkbox" class="bulk-actions__toggle-input" id="selectAll">
          <span class="bulk-actions__toggle-slider"></span>
        </div>
        <div class="bulk-actions__list">
          <div class="bulk-actions__item" data-action="delete">Eliminar seleccionados</div>
          <div class="bulk-actions__item data-action="publish">Publicar seleccionados</div>
          <div class="bulk-actions__item data-action="unpublish">Quitar publicación</div>
        </div>
        <div class="bulk-actions__select-all">
          <input type="checkbox" id="selectAll" class="bulk-actions__toggle-input">
          <label for="selectAll" class="text-sm text-slate-600 hover:text-primary transition-colors">Seleccionar todas</label>
        </div>
      </section>

      <!-- Activity Feed -->
      <section class="activity-feed">
        <div class="activity-feed__header">
          <span class="activity-feed__title">Actividad Reciente</span>
          <div class="activity-feed__filter">
            <button class="activity-feed__filter-btn activity-feed__filter-btn--active">Todo</button>
            <button class="activity-feed__filter-btn">Publicaciones</button>
            <button class="activity-feed__filter-btn">Propiedades</button>
            <button class="activity-feed__filter-btn">Usuarios</button>
          </div>
        </div>
        <div class="activity-feed__list" id="activityFeed">
          <div class="activity-feed__item">
            <div class="activity-feed__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 3l2 14 2-14 3 9h13a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5l2-10z"/>
              </svg>
            </div>
            <div class="activity-feed__details">
              <span>Nueva propiedad agregada: Casa en Miami Beach</span>
              <span class="activity-feed__timestamp">hace 10 min</span>
            </div>
          </div>
          <div class="activity-feed__item">
            <div class="activity-feed__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><path d="M18 20v-7"/>
              </svg>
            </div>
            <div class="activity-feed__details">
              <span>Banner publicado: Departamento en el Centro</span>
              <span class="activity-feed__timestamp">hace 25 min</span>
            </div>
          </div>
          <div class="activity-feed__item">
            <div class="activity-feed__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l7 7v3"/>
              </svg>
            </div>
            <div class="activity-feed__details">
              <span>Propiedad vendida: Terreno en Santo Domingo</span>
              <span class="activity-feed__timestamp">hace 1 hora</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Quick Nav -->
      <section class="quick-nav">
        <div class="quick-nav__title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Accesos Rápidos
        </div>
        <div class="quick-nav__list">
          <article class="quick-nav__item">
            <div class="quick-nav__item-link">
              <span class="material-symbols-outlined">apartment</span>
              <span>Propiedades</span>
            </div>
          </article>
          <article class="quick-nav__item">
            <div class="quick-nav__item-link">
              <span class="material-symbols-outlined">trending_up</span>
              <span>Estadísticas</span>
            </div>
          </article>
          <article class="quick-nav__item">
            <div class="quick-nav__item-link">
              <span class="material-symbols-outlined">people</span>
              <span>Usuarios</span>
            </div>
          </article>
          <article class="quick-nav__item">
            <div class="quick-nav__item-link">
              <span class="material-symbols-outlined">settings</span>
              <span>Configuración</span>
            </div>
          </article>
        </div>
      </section>

      <!-- FAB -->
      <button class="fab" aria-label="Agregar nueva propiedad">
        +
      </button>
    </div>

    <!-- Administrador de Banners -->
    <div class="banner-manager" id="banner-manager">
      <div class="banner-manager__header">
        <h2 class="banner-manager__header-title">Administrador de Banners</h2>
        <p class="banner-manager__subtitle">Gestiona los banners destacados de tu plataforma</p>
      </div>

      <!-- Sección: Añadir Nuevo Banner -->
      <section class="banner-form">
        <div class="banner-form__section">
          <span class="banner-form__section-title">Nuevo Banner</span>
          <div class="banner-form__field">
            <label class="banner-form__label" for="banner-title">Título</label>
            <input class="banner-form__input" type="text" id="banner-title" placeholder="Título de la campaña">
          </div>
          <div class="banner-form__field">
            <label class="banner-form__label">Prioridad</label>
            <select class="banner-form__select" id="banner-priority">
              <option value="normal">Normal</option>
              <option value="urgent">Urgente</option>
              <option value="featured">Destacado</option>
            </select>
          </div>
          <div class="banner-form__field">
            <label class="banner-form__label">Estado</label>
            <div class="banner-status-badges">
              <span class="banner-status-badge banner-status-badge--active" data-state="active">Activo</span>
              <span class="banner-status-badge banner-status-badge--inactive" data-state="inactive">Inactivo</span>
            </div>
          </div>
          <div class="banner-form__field">
            <label class="banner-form__label">Tipo</label>
            <select class="banner-form__select" id="banner-type">
              <option value="general">General</option>
              <option value="offer">Oferta</option>
              <option value="urgent">Urgente</option>
              <option value="featured">Destacado</option>
            </select>
          </div>
          <div class="banner-form__field">
            <label class="banner-form__label">Para Encabezado</label>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="banner-for-header" checked>
              <label class="form-check-label" for="banner-for-header">
                Mostrar en encabezado principal
              </label>
            </div>
          </div>
        </div>
        <div class="banner-form__section">
          <span class="banner-form__section-title">Imagen</span>
          <div class="banner-form__field">
            <label class="banner-form__label">Imagen del Banner</label>
            <input class="banner-form__input banner-manager__preview-image" id="banner-image" src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80" alt="Banner" loading="lazy">
          </div>
        </div>
        <button class="btn btn-accent w-100" type="button" aria-label="Crear nuevo banner">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Crear Banner
        </button>
      </section>

      <div class="banner-gallery" id="banner-gallery">
        <!-- Tarjetas de banner -->
        <article class="banner-card" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80');">
          <div class="banner-card__image-wrapper">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80" alt="Banner verano" class="banner-card__image" loading="lazy">
            <div class="banner-card__highlight-badge">
              <span class="material-symbols-outlined">tips_and_updates</span>
              <span>Para Encabezado</span>
            </div>
          </div>
          <div class="banner-card__info">
            <h4 class="banner-card__title">Verano 2026</h4>
            <p class="banner-card__subtitle">Hasta 30% de descuento en propiedades</p>
          </div>
          <div class="banner-card__toggle">
            <label class="toggle-switch">
              <input type="checkbox" class="toggle-switch-input" checked>
              <span class="toggle-switch-slider"></span>
            </label>
          </div>
        </article>
        <article class="banner-card">
          <div class="banner-card__image-wrapper">
            <img src="https://images.unsplash.com/photo-1613443611439-2f0e7e0f245c?w=800&q=80" alt="Nuevas propiedades" class="banner-card__image" loading="lazy">
            <div class="banner-card__highlight-badge" style="display:none;">
              <span class="material-symbols-outlined">tips_and_updates</span>
              <span>Para Encabezado</span>
            </div>
          </div>
          <div class="banner-card__info">
            <h4 class="banner-card__title">Nuevas Propiedades</h4>
            <p class="banner-card__subtitle">50 propiedades recién añadidas</p>
          </div>
          <div class="banner-card__toggle">
            <label class="toggle-switch">
              <input type="checkbox" class="toggle-switch-input">
              <span class="toggle-switch-slider"></span>
            </label>
          </div>
        </article>
        <article class="banner-card">
          <div class="banner-card__image-wrapper">
            <img src="https://images.unsplash.com/photo-1601426526298-8f5a71408835?w=800&q=80" alt="Invierno" class="banner-card__image" loading="lazy">
            <div class="banner-card__highlight-badge">
              <span class="material-symbols-outlined">tips_and_updates</span>
              <span>Para Encabezado</span>
            </div>
          </div>
          <div class="banner-card__info">
            <h4 class="banner-card__title">Invierno</h4>
            <p class="banner-card__subtitle">Propiedades exclusivas de invierno</p>
          </div>
          <div class="banner-card__toggle">
            <label class="toggle-switch">
              <input type="checkbox" class="toggle-switch-input" checked>
              <span class="toggle-switch-slider"></span>
            </label>
          </div>
        </article>
      </div>
    </div>

  </div>

  <script>
    // Inicialización
    document.addEventListener('DOMContentLoaded', function() {
      // Inicializar carousel
      const carouselTrack = document.getElementById('carousel-track');
      if (carouselTrack) {
        const carouselProperties = [
          {
            image: 'https://images.unsplash.com/photo-1600607687333-ce6a7e8044f1?w=800&q=80',
            title: 'Casa de Lujo en Miami',
            meta: '3 habitaciones | 2 baños | $2,500,000',
            price: '$2.5M'
          },
          {
            image: 'https://images.unsplash.com/photo-1613443611439-2f0e7e0f245c?w=800&q=80',
            title: 'Departamento Moderno',
            meta: '2 habitaciones | 1 baño | $890,000',
            price: '$890k'
          },
          {
            image: 'https://images.unsplash.com/photo-1601426526298-8f5a71408835?w=800&q=80',
            title: 'Terreno en Santo Domingo',
            meta: '500 m² | Zona residencial',
            price: 'Consultar'
          }
        ];

        carouselProperties.forEach(prop => {
          const card = document.createElement('div');
          card.className = 'carousel__item';
          card.innerHTML = `
            <img src="${prop.image}" alt="${prop.title}" class="carousel__image" loading="lazy">
            <div class="carousel__content">
              <h4 class="carousel__title">${prop.title}</h4>
              <p class="carousel__meta">${prop.meta}</p>
              <p class="carousel__price">${prop.price}</p>
            </div>
          `;
          carouselTrack.appendChild(card);
        });
      }

      // Inicializar grid de propiedades
      const propertiesGrid = document.getElementById('properties-grid');
      if (propertiesGrid) {
        const properties = [
          {
            image: 'https://images.unsplash.com/photo-1600607687333-ce6a7e8044f1?w=600&q=80',
            title: 'Casa de Lujo en Miami Beach',
            location: 'Miami Beach, FL',
            features: ['Piscina', 'Jardín', '4 habitaciones'],
            price: '$2,500,000',
            status: 'Disponible'
          },
          {
            image: 'https://images.unsplash.com/photo-1613443611439-2f0e7e0f245c?w=600&q=80',
            title: 'Departamento Moderno en Madrid',
            location: 'Madrid, España',
            features: ['Balcon', 'Gimnasio', '2 habitaciones'],
            price: '$450,000',
            status: 'Disponible'
          },
          {
            image: 'https://images.unsplash.com/photo-1601426526298-8f5a71408835?w=600&q=80',
            title: 'Terreno en Santo Domingo',
            location: 'Santo Domingo, RD',
            features: ['Plano', 'Urbanizar', '500 m²'],
            price: '$350,000',
            status: 'Destacado'
          }
        ];

        propertiesGrid.innerHTML = properties.map(prop => `
          <article class="property-card">
            <div class="property-card__image-wrapper">
              <img src="${prop.image}" alt="${prop.title}" class="property-card__image" loading="lazy">
              <div class="property-card__overlay"></div>
              <span class="property-card__badge badge badge--rent">Renta</span>
            </div>
            <div class="property-card__body">
              <h3 class="property-card__title">${prop.title}</h3>
              <p class="property-card__location">${prop.location}</p>
              <div class="property-card__features">
                ${prop.features.map(feature => `<span class="property-card__feature"><span class="property-card__feature-icon">✓</span>${feature}</span>`).join('')}
              </div>
              <div class="property-card__footer">
                <div class="property-card__price">${prop.price}</div>
                <span class="property-card__status badge badge--rent">Renta</span>
              </div>
            </div>
          </article>
        `).join('');
      }

      // Avatar init
      const avatars = document.querySelectorAll('.avatar');
      avatars.forEach(avatar => {
        avatar.style.backgroundColor = 'var(--color-primary-dark)';
        avatar.style.color = 'var(--color-bg-primary)';
      });

      // Tooltips simples
      const tooltips = document.querySelectorAll('.tooltip');
      tooltips.forEach(tooltip => {
        tooltip.addEventListener('mouseover', function() {
          const tooltipText = this.getAttribute('data-tooltip');
          const tooltipEl = document.createElement('div');
          tooltipEl.className = 'tooltip-text';
          tooltipEl.textContent = tooltipText;
          this.appendChild(tooltipEl);
        });
      });

      // WhatsApp CTA
      const whatsappCTA = document.querySelector('.whatsapp-cta');
      if (whatsappCTA) {
        whatsappCTA.addEventListener('click', function() {
          const phone = '524792761205';
          const text = 'Hola, me interesa la propiedad';
          window.open(`https://wa.me/${phone}?text=${encodeURIComponent(text)}`, '_blank');
        });
      }
    });

    // Panel de Administración
    const adminNavLink = document.getElementById('admin-nav-link');
    const publicPage = document.getElementById('public-page');
    const dashboardSection = document.querySelector('.dashboard-main');
    
    if (adminNavLink && publicPage && dashboardSection) {
      let isAdminMode = false;
      
      adminNavLink.addEventListener('click', function(e) {
        e.preventDefault();
        isAdminMode = !isAdminMode;
        
        if (isAdminMode) {
          // Cambiar a modo administrador
          publicPage.style.display = 'none';
          dashboardSection.style.display = 'block';
          adminNavLink.innerHTML = `
            <span class="material-symbols-outlined">tips_and_updates</span>
            <span>Modo Público</span>
          `;
          adminNavLink.style.borderColor = 'var(--color-accent-blue)';
          adminNavLink.style.color = 'var(--color-accent-blue)';
        } else {
          // Regresar modo público
          publicPage.style.display = 'block';
          dashboardSection.style.display = 'none';
          adminNavLink.innerHTML = `
            <span class="material-symbols-outlined">admin_panel_settings</span>
            <span>Panel Admin</span>
          `;
          adminNavLink.style.borderColor = 'var(--color-primary)';
          adminNavLink.style.color = 'var(--color-primary)';
        }
      });
    }
</script>
</body>
</html>